# Copia este archivo a server/.env y completa los valores.
# Genera el token con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

PORT=8787

# Cadena de Postgres. Ejemplos (deja solo una):
# Local sin SSL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/registro_actopan
# Supabase (Session pooler o conexión directa):
# DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Neon:
# DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Railway:
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:5432/railway?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/registro_actopan

# auto: SSL si el host es Supabase/Neon/Railway o la URL trae sslmode=require.
# require: forzar SSL. disable: Postgres local sin SSL.
PGSSL=auto
# Pon false solo si el proveedor usa un certificado que Node no reconoce.
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# Secreto compartido de los 10 dispositivos de staff. Mínimo 16 caracteres.
# No lo pongas en el frontend ni en el repositorio.
STAFF_TOKEN=replace-with-openssl-rand-hex-32

# Orígenes del navegador, separados por coma. Usa * solo en desarrollo.
# En producción pon el dominio HTTPS real, por ejemplo https://evento.example.com
CORS_ORIGIN=http://localhost:5173

# production cuando el proceso también sirve client/dist
NODE_ENV=development
